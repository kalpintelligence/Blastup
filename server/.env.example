# Server Environment Variables
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wa_platform

# JWT (must be at least 32 chars)
JWT_SECRET=change_this_to_a_very_long_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# Cookie encryption
COOKIE_SECRET=change_this_cookie_secret_to_something_long_and_random

# bcrypt rounds (higher = more secure but slower, 12 is good)
BCRYPT_ROUNDS=12

# Admin seed credentials (used by npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately

# CORS — must match your frontend URL
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# WhatsApp session storage
SESSION_DIR=./sessions

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Logging
LOG_LEVEL=info

# Redis (Safe Mode anti-ban system + future caching)
REDIS_URL=redis://localhost:6379
