# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wa_platform

# JWT (MUST be at least 32 random characters — generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=24h

# Cookie secret (MUST be at least 32 random characters)
COOKIE_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# bcrypt rounds
BCRYPT_ROUNDS=12

# Admin seed (run: cd server && npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS — exact URL of your frontend
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# WhatsApp session storage
SESSION_DIR=./sessions

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Logging
LOG_LEVEL=info

# ── Client ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
